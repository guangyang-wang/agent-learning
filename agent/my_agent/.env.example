# 复制本文件为 .env 并填入真实值：cp .env.example .env

# ============ DeepSeek ============
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ Embedding 向量化（硅基流动，默认 BGE） ============
# 注册/建 key：https://cloud.siliconflow.cn ，免费模型含 BAAI/bge-m3 等
EMBEDDING_PROVIDER=siliconflow        # 可插拔：siliconflow / openai / local
EMBEDDING_MODEL=BAAI/bge-m3           # 中文课件可选 bge-m3 或 bge-large-zh-v1.5
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ============ 可观测（LangSmith，可选） ============
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=learning-agent

# ============ FastAPI 服务 ============
HOST=0.0.0.0
PORT=8000
